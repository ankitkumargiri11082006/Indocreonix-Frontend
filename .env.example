VITE_CHAT_PROVIDER=openai
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_CHAT_MODEL=gpt-4o-mini
VITE_API_BASE_URL=http://localhost:5000/api
# VITE_API_BASE_URL=https://your-backend-domain.com/api
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Optional but recommended: move admin UI off the default /admin route.
# Set this to a hard-to-guess path in production and redeploy.
# Example: VITE_ADMIN_PATH=/admin-9f2a8c0c1b
VITE_ADMIN_PATH=/admin

# Optional Gemini fallback:
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional OpenRouter fallback:
# VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here


